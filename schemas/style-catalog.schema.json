{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pano.local/schemas/style-catalog/0.1.0",
  "title": "StyleCatalog",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "source", "styles", "contentHash"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "source": { "type": "string", "minLength": 1 },
    "styles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/style" } },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "style": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "designStyle", "visualMode", "inspirations", "palette", "materials", "promptSuffix"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 },
        "designStyle": { "type": "string", "minLength": 1 }, "visualMode": { "const": "realistic" },
        "inspirations": { "type": "array", "items": { "type": "string" } },
        "palette": { "type": "array", "items": { "type": "string" } },
        "materials": { "type": "array", "items": { "type": "string" } },
        "promptSuffix": { "type": "string", "minLength": 1 }
      }
    }
  }
}
