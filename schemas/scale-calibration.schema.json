{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pano.local/schemas/scale-calibration/0.1.0",
  "title": "ScaleCalibrationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sampleId", "observations", "pixelOrigin", "worldOrigin", "maxRelativeResidual"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "sampleId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observation" }
    },
    "pixelOrigin": { "$ref": "#/$defs/point" },
    "worldOrigin": { "$ref": "#/$defs/point" },
    "maxRelativeResidual": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.25 }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pixelDistance", "worldDistanceMm", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pixelDistance": { "type": "number", "exclusiveMinimum": 0 },
        "worldDistanceMm": { "type": "number", "exclusiveMinimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
